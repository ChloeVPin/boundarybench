{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChloeVPin/boundarybench/schemas/study.schema.json",
  "title": "BoundaryBench preregistered study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_version",
    "status",
    "title",
    "price_basis_date",
    "funding_cap_usd",
    "replication_reserve_fraction",
    "research_questions",
    "hypotheses",
    "design",
    "arms",
    "models",
    "token_budget_per_case",
    "analysis",
    "exclusions",
    "stopping_rule",
    "responsible_research"
  ],
  "properties": {
    "study_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"const": "preregistered"},
    "title": {"type": "string", "minLength": 1},
    "price_basis_date": {"type": "string", "format": "date"},
    "funding_cap_usd": {"type": "number", "exclusiveMinimum": 0},
    "replication_reserve_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "research_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "hypotheses": {
      "type": "array",
      "items": {"$ref": "#/$defs/hypothesis"},
      "minItems": 1
    },
    "design": {"$ref": "#/$defs/design"},
    "arms": {
      "type": "array",
      "items": {"$ref": "#/$defs/arm"},
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/model"},
      "minItems": 1
    },
    "token_budget_per_case": {"$ref": "#/$defs/tokenBudget"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "stopping_rule": {"$ref": "#/$defs/stoppingRule"},
    "responsible_research": {"$ref": "#/$defs/responsibleResearch"}
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "estimand", "direction"],
      "properties": {
        "id": {"type": "string", "pattern": "^H[1-9][0-9]*$"},
        "statement": {"type": "string", "minLength": 1},
        "estimand": {"type": "string", "minLength": 1},
        "direction": {"enum": ["positive", "negative", "two-sided"]}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_root",
        "paired_clean_controls",
        "positions",
        "pressure_levels",
        "provenance_modes",
        "trials_per_cell",
        "seed"
      ],
      "properties": {
        "scenario_root": {"type": "string", "minLength": 1},
        "paired_clean_controls": {"const": true},
        "positions": {
          "type": "array",
          "items": {"enum": ["early", "middle", "late"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "pressure_levels": {
          "type": "array",
          "items": {"enum": [1, 3, 5]},
          "minItems": 1,
          "uniqueItems": true
        },
        "provenance_modes": {
          "type": "array",
          "items": {"enum": ["explicit", "source_only", "flattened"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "trials_per_cell": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "adapter_mitigation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "adapter_mitigation": {"enum": ["none", "authority-checkpoint"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_per_million_usd", "output_per_million_usd"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input_per_million_usd": {"type": "number", "minimum": 0},
        "output_per_million_usd": {"type": "number", "minimum": 0}
      }
    },
    "tokenBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "accounting"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 1},
        "accounting": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_outcome",
        "primary_estimand",
        "secondary_estimands",
        "uncertainty",
        "reporting"
      ],
      "properties": {
        "primary_outcome": {"const": "safe_completion"},
        "primary_estimand": {"const": "attack_control_gap"},
        "secondary_estimands": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rates", "matched_effects"],
          "properties": {
            "rates": {"type": "string", "minLength": 1},
            "matched_effects": {"type": "string", "minLength": 1}
          }
        },
        "reporting": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "stoppingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_cases", "policy", "restart"],
      "properties": {
        "planned_cases": {"type": "integer", "minimum": 1},
        "policy": {"type": "string", "minLength": 1},
        "restart": {"type": "string", "minLength": 1}
      }
    },
    "responsibleResearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "network", "people", "disclosure", "publication"],
      "properties": {
        "data": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "people": {"type": "string", "minLength": 1},
        "disclosure": {"type": "string", "minLength": 1},
        "publication": {"type": "string", "minLength": 1}
      }
    }
  }
}
